

# --- REAL options data (PRIMARY) — powered by PVE.trade v1 (chain, Greeks, IV, OI, GEX, sweeps) ---
# Recommended: pve (same PVE.trade account, no extra vendor). Alternative adapter: polygon.
# Leave OPTIONS_PROVIDER=null to run without real options (tab shows "Insufficient options data").
OPTIONS_PROVIDER=uw
OPTIONS_API_KEY=            # your pve_live_... key (server-side only) for provider=pve
# OPTIONS_BASE_URL=https://api.pve.trade/api/v1   # override only if needed

# --- ADVISORY AI layer (OpenRouter) — optional; on-demand only, never affects the Signal Score ---
# Get a key at openrouter.ai. Server-side only. Leave unset to disable AI (app works without it).
OPENROUTER_API_KEY=            # sk-or-...
OPENROUTER_MODEL=openai/gpt-4o-mini          # any OpenRouter model slug (author/slug)
# OPENROUTER_FALLBACK_MODEL=google/gemini-2.0-flash-001
# AI_ENABLED=true              # set false to hard-disable even if a key is present
# AI_CACHE_TTL_MS=600000       # cache AI results per ticker (default 10 min)
# OPENROUTER_TIMEOUT_MS=30000

# --- AI layer: per-role model routing (optional; both default to OPENROUTER_MODEL) ---
# OPENROUTER_MODEL_ANALYST=openai/gpt-4o-mini        # cheap model for analyst extraction
# OPENROUTER_MODEL_MANAGER=openai/gpt-4o-mini        # stronger model for bull/bear/risk/summary
# When ANALYST and MANAGER models are identical, a SINGLE OpenRouter call is used (no extra cost).
# OPENROUTER_REASONING_ANALYST=false
# OPENROUTER_REASONING_MANAGER=false
# AI_STRUCTURED=true          # prefer native JSON output; auto-falls back to the text parser
# --- AI-run persistence (optional; OFF by default; never stores keys/prompts) ---
# AI_PERSIST=false
# AI_LOG_DIR=./ai-runs

# --- Phase 0 research harness (OFFLINE; not used by the server; never feeds scoring) ---
# Used only by research/capture-snapshot.js when you run it manually or via cron on the VPS.
# RESEARCH_SNAPSHOT_DIR=./research-data/snapshots
# RESEARCH_SIGNAL_DIR=./research-data/signals
# RESEARCH_TICKERS=AAPL,MSFT,NVDA,SPY,QQQ

# Unusual Whales (default provider). Get a token at unusualwhales.com (Free tier works).
OPTIONS_PROVIDER=uw
UNUSUAL_WHALES_API_TOKEN=uw_xxx
# Legacy PVE fallback (kept until UW validated live): set OPTIONS_PROVIDER=pve to switch back
# OPTIONS_API_KEY=pve_live_xxx
