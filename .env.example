# Copy to .env and fill in. Never commit .env.
# No inline comments after values: put comments on their own lines.

# Options data provider. Unusual Whales is the only supported source.
OPTIONS_PROVIDER=uw
UNUSUAL_WHALES_API_TOKEN=

# REQUIRED: dashboard login password, at least 16 characters. The server refuses to start without it.
DASHBOARD_PASSWORD=
# REQUIRED: random string of at least 32 characters that signs session cookies.
# Rotating it logs everyone out.
SESSION_SECRET=
# Set to true when serving over HTTPS so the session cookie gets the Secure flag.
COOKIE_SECURE=false
# Set to true when running behind a reverse proxy so per-IP login throttling sees the real client IP.
TRUST_PROXY=false

PORT=4000

# Unusual Whales rate-limit budget. Leave blank to rely on UW response headers only.
UW_MAX_PER_MINUTE=
UW_MAX_PER_SCAN=12000

# Universe scan
SCAN_LIMIT=1000
SCAN_CONCURRENCY=6
SCAN_GAP_MS=
SCAN_DIR=./research-data/scan

# Journal and baselines
SIGNAL_LOG_DIR=./research-data/signal-log
BASELINE_DIR=./research-data/baselines

# Advisory AI (explain-only, never changes a score). Off by default.
AI_ENABLED=false
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
AI_PERSIST=false
